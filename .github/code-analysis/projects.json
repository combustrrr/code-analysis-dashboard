        "mode": "portable",
        "python_root": "scripts/code_analysis",
        "javascript_root": "analysis-ui",
        "commands": {
          "eslint": {
            "cwd": "analysis-ui",
            "install": [
              [
                "npm",
                "ci",
                "--ignore-scripts"
              ],
              [
                "npm",
                "install",
                "--no-save",
                "--ignore-scripts",
                "eslint@9.34.0",
                "typescript-eslint@8.42.0"
              ]
            ],
            "argv": [
              "npx",
              "--no-install",
              "eslint",
              "src",
              "--format",
              "json",
              "--output-file",
              "eslint-results.json"
            ]
          },
          "typescript": {
            "cwd": "analysis-ui",
            "install": [
              [
                "npm",
                "ci",
                "--ignore-scripts"
              ]
            ],
            "argv": [
              "npx",
              "--no-install",
              "tsc",
              "--noEmit",
              "--pretty",
              "false"
            ]
          },
          "coverage": {
            "argv": [
              "python",
              "-m",
              "coverage",
              "run",
              "--source=scripts/code_analysis",
              "-m",
              "unittest",
              "scripts.code_analysis.test_portable_profile",
              "scripts.code_analysis.test_projects"
            ]
          },
          "atheris": {
            "argv": [
              "python",
              "tests/security_canary/fuzz_portable_profile.py",
              "-runs=25000",
              "-max_total_time=60"
            ]
          },
          "pyright": {
            "install": [
              [
                "python",
                "-m",
                "pip",
                "install",
                "pyright==1.1.405"
              ]
            ],
            "argv": [
              "pyright",
              "scripts/code_analysis",
              "--outputjson"
            ]
          }
        }
      },
