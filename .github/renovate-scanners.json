{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["github-actions", "pip_requirements", "custom.regex"],
  "includePaths": [
    ".ci/**",
    "config/code-analysis/workflow-templates/**",
    ".github/workflows/06-canary-validation.yml",
    ".github/workflows/13-scanner-updates.yml",
    ".github/workflows/reusable-vendor.yml",
    "scripts/code_analysis/generate_source_workflow.py",
    "scripts/code_analysis/community_workflow.py",
    "scripts/code_analysis/portable_workflow.py",
    ".github/code-analysis/projects.json"
  ],
  "ignorePaths": [
    ".github/workflows/11-source-analysis.yml",
    ".github/workflows/12-scanner-diagnostics.yml",
    ".github/workflows/reusable-source.yml",
    ".github/workflows/reusable-source-full.yml"
  ],
  "pip_requirements": {"managerFilePatterns": ["/^\\.ci/.*requirements.*\\.txt$/"]},
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.ci/scorecard\\.json$/"],
      "matchStrings": ["\"version\": \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "ossf/scorecard",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.ci/trufflehog\\.json$/"],
      "matchStrings": ["\"version\": \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "trufflesecurity/trufflehog",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^config/code-analysis/workflow-templates/.*\\.yml$/",
        "/^\\.github/workflows/(06-canary-validation|13-scanner-updates|reusable-vendor)\\.yml$/",
        "/^scripts/code_analysis/(generate_source_workflow|community_workflow|portable_workflow)\\.py$/",
        "/^\\.github/code-analysis/projects\\.json$/"
      ],
      "matchStrings": ["(?<depName>[A-Za-z][A-Za-z0-9_.-]+)==(?<currentValue>[0-9]+(?:\\.[0-9A-Za-z]+)+)"],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^config/code-analysis/workflow-templates/.*\\.yml$/",
        "/^\\.github/workflows/(13-scanner-updates|reusable-vendor)\\.yml$/",
        "/^\\.github/code-analysis/projects\\.json$/"
      ],
      "matchStrings": ["(?<depName>snyk|renovate|eslint|typescript-eslint|eslint-plugin-react|typescript)@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^config/code-analysis/workflow-templates/.*\\.yml$/",
        "/^\\.github/workflows/06-canary-validation\\.yml$/",
        "/^scripts/code_analysis/generate_source_workflow\\.py$/"
      ],
      "matchStrings": ["(?<depName>zricethezav/gitleaks):(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "datasourceTemplate": "docker"
    }
  ],
  "dependencyDashboard": false,
  "branchPrefix": "scanner-updates/",
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "minimumReleaseAge": "3 days",
  "ignoreUnstable": true,
  "rangeStrategy": "pin",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "packageRules": [
    {
      "description": "Group stable scanner releases into one compatibility-tested tooling promotion",
      "matchFileNames": [
        ".ci/**",
        "config/code-analysis/workflow-templates/**",
        ".github/workflows/06-canary-validation.yml",
        ".github/workflows/13-scanner-updates.yml",
        ".github/workflows/reusable-vendor.yml",
        "scripts/code_analysis/generate_source_workflow.py",
        "scripts/code_analysis/community_workflow.py",
        "scripts/code_analysis/portable_workflow.py",
        ".github/code-analysis/projects.json"
      ],
      "matchUpdateTypes": ["major", "minor", "patch", "digest", "pin"],
      "groupName": "validated scanner stack",
      "automerge": true
    }
  ],
  "postUpgradeTasks": {
    "commands": ["python -m scripts.code_analysis.sync_scanner_workflows"],
    "fileFilters": [
      ".ci/scorecard.json",
      ".ci/trufflehog.json",
      "config/code-analysis/workflow-templates/**",
      "scripts/code_analysis/generate_source_workflow.py",
      "scripts/code_analysis/community_workflow.py",
      "scripts/code_analysis/portable_workflow.py",
      ".github/workflows/11-source-analysis.yml",
      ".github/workflows/12-scanner-diagnostics.yml",
      ".github/workflows/reusable-source.yml",
      ".github/workflows/reusable-source-full.yml"
    ],
    "executionMode": "branch"
  }
}
