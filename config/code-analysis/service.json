{
  "schema_version": "analysis-service-v1",
  "source_repository": "ARYDESTROYER/Kavach-AgenticSOC",
  "analysis_repository": "combustrrr/code-analysis-dashboard",
  "publishing_repository": "combustrrr/code-analysis-dashboard",
  "preferred_branch": "Testing",
  "source_workflow": ".github/workflows/code-analysis-coordinator.yml",
  "artifact_retention_days": 7,
  "site_limit_bytes": 900000000,
  "deferred_channels": {},
  "profile": {
    "snyk_python_manifests": [
      ".ci/requirements.txt",
      "backend/requirements.txt",
      "docs/requirements.txt"
    ],
    "snyk_npm_manifests": [
      "webui/package-lock.json",
      "archive/kibana-plugin/tlsoc_agentic_triage/package.json"
    ],
    "python_root": "backend",
    "python_requirements": "backend/requirements.txt",
    "python_development_requirements": "backend/requirements-dev.txt",
    "python_test_command": [
      "python",
      "-m",
      "pytest",
      "-q",
      "--cov=app",
      "--cov-report=json:coverage.json"
    ],
    "javascript_root": "webui",
    "javascript_install_command": [
      "npm",
      "ci",
      "--ignore-scripts"
    ],
    "javascript_test_command": [
      "npm",
      "run",
      "test"
    ],
    "frontend_build_command": ["npm", "run", "build:app"],
    "frontend_preview_command": ["npm", "run", "preview", "--", "--host", "127.0.0.1", "--port", "4178"],
    "frontend_preview_url": "http://127.0.0.1:4178/",
    "frontend_lighthouse_budgets": {
      "performance": 0.9,
      "accessibility": 0.95,
      "lcp_ms": 2500,
      "cls": 0.1
    },
    "api_command": [
      "python",
      "-m",
      "uvicorn",
      "app.main:app",
      "--host",
      "127.0.0.1",
      "--port",
      "8088"
    ],
    "openapi_url": "http://127.0.0.1:8088/openapi.json",
    "api_environment": {
      "TLSOC_AUTH_ENABLED": "false"
    }
  },
  "enabled_scanners": [
    "alibaba-ocr",
    "atheris",
    "bandit",
    "checkov",
    "codeql",
    "coderabbit-ai-advisory",
    "codex-security",
    "coverage",
    "eslint",
    "flounder-audit",
    "github-actions-security",
    "github-secret-protection-posture",
    "gitleaks",
    "hadolint",
    "openssf-scorecard",
    "osv",
    "owasp-go",
    "owasp-iac-secrets",
    "owasp-js",
    "owasp-jvm",
    "owasp-ruby",
    "pyright",
    "radon",
    "ruff",
    "sbom-license-provenance",
    "schemathesis",
    "semgrep",
    "shipping-image-cves",
    "snyk",
    "sonarqube-cloud",
    "trivy",
    "typescript",
    "vulnagent-triage",
    "vulture",
    "xenon"
  ],
  "scanner_extensions": [
    {
      "channel": "ext-frontend-build",
      "name": "Frontend production build",
      "class": "reliability",
      "mode": "source",
      "adapter": "scripts/code_analysis/adapters/frontend_build.py",
      "timeout_minutes": 25,
      "evidence_source": "DETERMINISTIC",
      "sensitive": false
    },
    {
      "channel": "ext-frontend-tests",
      "name": "Frontend test suite",
      "class": "reliability",
      "mode": "source",
      "adapter": "scripts/code_analysis/adapters/frontend_tests.py",
      "timeout_minutes": 25,
      "evidence_source": "DETERMINISTIC",
      "sensitive": false
    },
    {
      "channel": "ext-github-security-advisories",
      "name": "GitHub Security Advisories",
      "class": "security",
      "mode": "vendor",
      "adapter": "scripts/code_analysis/adapters/github_security_advisories.py",
      "timeout_minutes": 5,
      "evidence_source": "DETERMINISTIC",
      "sensitive": false
    },
    {
      "channel": "ext-axe-accessibility",
      "name": "axe WCAG browser audit",
      "class": "reliability",
      "mode": "source",
      "adapter": "scripts/code_analysis/adapters/frontend_axe.py",
      "timeout_minutes": 20,
      "evidence_source": "DETERMINISTIC",
      "sensitive": false
    },
    {
      "channel": "ext-lighthouse-ui",
      "name": "Lighthouse UI budgets",
      "class": "reliability",
      "mode": "source",
      "adapter": "scripts/code_analysis/adapters/frontend_lighthouse.py",
      "timeout_minutes": 25,
      "evidence_source": "DETERMINISTIC",
      "sensitive": false
    }
  ],
  "launch_endpoint": "https://code-analysis-launcher.icsarthak9.workers.dev"
}
