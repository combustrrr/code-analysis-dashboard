{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "code-analysis-launcher",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "vars": {
    "SOURCE_REPOSITORY": "ARYDESTROYER/Kavach-AgenticSOC",
    "ANALYSIS_REPOSITORY": "combustrrr/code-analysis-dashboard",
    "DASHBOARD_ORIGIN": "https://combustrrr.github.io",
    "GITHUB_CLIENT_ID": "Iv23lixjTGgPaq9Jfp6R",
    "NEXT_GITHUB_CLIENT_ID": "Iv23liZLGddxXQUEV3Lq",
    "NEXT_GITHUB_APP_ID": "4893614",
    "NEXT_GITHUB_APP_SLUG": "code-analysis-dashboard",
    "APPLICATION_MODE": "repositories",
    "DASHBOARD_ACCESS": "collaborators",
    "GITHUB_OAUTH_SCOPES": "public_repo",
    "TOOLING_FROM_SERVICE": "true",
    "TOOLING_SHA": "fd0e887cc39b0fcd4d4c029164d6fa9aa7c704a0",
    "EVALUATION_MODE": "true",
    "EVALUATION_SOURCE_REPOSITORY": "ARYDESTROYER/Kavach-AgenticSOC",
    "EVALUATION_TARGET_BRANCH": "Testing",
    "EVALUATION_TARGET_SHA": "231bb41f7eb1b707e25113c258eb8d5c7356b743",
    "EVALUATION_PAUSED": "false",
    "SAFE_API_LOGS": "true",
    "MAX_ASSET_BYTES": "104857600",
    "MAX_MANIFEST_COMPRESSED_BYTES": "900000000",
    "MAX_LAUNCH_BYTES": "2048",
    "MAX_APPLICATION_JSON_BYTES": "65536",
    "MAX_STATE_BYTES": "26214400",
    "MAX_MANIFEST_JSON_BYTES": "16777216",
    "MAX_REPORT_AGE_MS": "86400000"
  },
  "secrets": {
    "required": [
      "GITHUB_CLIENT_SECRET",
      "NEXT_GITHUB_CLIENT_SECRET",
      "NEXT_GITHUB_APP_PRIVATE_KEY",
      "NEXT_GITHUB_WEBHOOK_SECRET",
      "SESSION_KEY",
      "WORKER_API_TOKEN"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "ANALYSIS_STATE",
      "id": "c62eec3859794af5af38db282b0f69d5"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ANALYSIS_REPORTS",
      "bucket_name": "code-analysis-reports"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "preview_urls": false
}
